{
  "name": "builderhunt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:all": "pnpm db:up && pnpm db:migrate && pnpm db:seed:admin && pnpm dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run test/security",
    "test:rls": "pnpm test:rls:local",
    "test:e2e": "playwright test",
    "db:up": "docker inspect workspace-postgres --format '{{.State.Running}}' 2>/dev/null | grep -q true || docker compose --profile standalone up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:audit-schema": "tsx scripts/db/audit-schema.ts",
    "db:backfill:organizations": "tsx --env-file=.env scripts/db/backfills/organizations.ts",
    "db:backfill:resources": "tsx --env-file=.env scripts/db/backfills/resources.ts",
    "db:backfill:builders": "tsx --env-file=.env scripts/db/backfills/builders.ts",
    "test:rls:local": "node scripts/db/verify-rls-local.mjs",
    "test:api-isolation:local": "tsx scripts/db/verify-api-isolation-local.mjs",
    "test:migrations:local": "node scripts/db/verify-migrations-local.mjs",
    "test:migration-integrity": "node scripts/db/verify-migration-integrity.mjs",
    "db:restore-test": "tsx scripts/db/restore-test.ts",
    "security:boundaries": "node scripts/check-tenant-boundaries.mjs",
    "security:route-coverage": "node scripts/check-route-coverage.mjs",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "db:migrate": "tsx --env-file=.env scripts/db/create-db.ts && drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:seed:admin": "tsx --env-file=.env scripts/db/seed-admin.ts",
    "deploy:db": "node scripts/deploy/orchestrate.mjs",
    "deploy:db:dry": "node scripts/deploy/orchestrate.mjs --dry-run",
    "deploy:preflight": "node scripts/deploy/preflight.mjs",
    "stripe:provision": "tsx --env-file=.env scripts/billing/provision-stripe-catalog.ts",
    "billing:check-readiness": "tsx --env-file=.env scripts/billing/check-live-readiness.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.28",
    "@tanstack/react-start-client": "^1.168.16",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.6",
    "motion": "^12.42.2",
    "postgres": "^3.4.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "stripe": "22.3.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.20",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "ioredis": "^5.11.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}

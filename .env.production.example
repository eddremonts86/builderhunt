# builderhunt — Production Environment Configuration
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production — only .env.production.example is tracked.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://builderhunt.eduardoinerarte.dk
VITE_APP_URL=https://builderhunt.eduardoinerarte.dk

# ── Database ──────────────────────────────────────────────────────────────────
# The web service receives only DATABASE_URL. Supply DATABASE_MIGRATION_URL to
# the migration job and DATABASE_WORKER_URL only to the worker service.
DATABASE_URL=postgresql://builderhunt_app:change_me_runtime_password@db:5432/builderhunt
DATABASE_MIGRATION_URL=postgresql://migration_operator:change_me_owner_password@db:5432/builderhunt
DATABASE_AUTH_URL=postgresql://builderhunt_auth:change_me_auth_password@db:5432/builderhunt
DATABASE_WORKER_URL=postgresql://builderhunt_worker:change_me_worker_password@db:5432/builderhunt
DATABASE_PLATFORM_URL=postgresql://builderhunt_platform:change_me_platform_password@db:5432/builderhunt
TENANT_READ_MODE=legacy
TENANT_WRITE_MODE=legacy
TENANT_CANONICAL_READY=false

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_MODE=local
BETTER_AUTH_SECRET=change_me_generate_with_openssl  # openssl rand -base64 32
BETTER_AUTH_URL=https://builderhunt.eduardoinerarte.dk

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                        # from resend.com

# ── External Source API Tokens ────────────────────────────────────────────────
GITHUB_TOKEN=                          # github.com → Settings → Developer settings → PAT
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=                       # from sentry.io → Project → DSN

# ── AI (Plan: ai-expansion / semantic-search) ─────────────────────────────────
# See plans/_meta/ai-policy.md and docs/operations/database-migrations.md
# ("Self-hosted embeddings" section) for the full deployment contract.
MINIMAX_API_KEY=                       # unset = server AI tier disabled (Chrome AI still works)
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=MiniMax-M3
# Embeddings: self-hosted Ollama container (docker-compose.yml `embeddings`
# service), deployed as its own Coolify resource, serving nomic-embed-text
# (768-dim) via its OpenAI-compatible /v1/embeddings endpoint. Point this at
# that resource's internal hostname — never MiniMax (ai-policy.md §3).
AI_EMBEDDING_URL=http://embeddings:11434/v1/embeddings
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIM=768
AI_EMBEDDING_TIMEOUT_MS=30000
AI_DISABLED=false                      # kill switch — set true + redeploy to disable all server AI
AI_DISABLED_TASKS=

# ── Public Profile Enrichment (plan: stealth-scraping) ───────────────────────
# Stays false until the source register + legal copy + canary in
# implementation_plan.md Phase 7 are all signed off. This is the production
# kill switch: false means no jobs are ever created and the worker is a no-op.
ENRICHMENT_ENABLED=false
ENRICHMENT_ALLOWED_CONNECTORS=github
ENRICHMENT_BATCH_SIZE=2                # per implementation_plan.md rollout: batch size 2 for the canary
ENRICHMENT_MAX_ATTEMPTS=3
ENRICHMENT_LEASE_SECONDS=300
ENRICHMENT_RAW_RETENTION_DAYS=30
ENRICHMENT_ACCEPTED_RETENTION_DAYS=180
ENRICHMENT_USER_AGENT=BuilderHuntBot/1.0 (+https://builderhunt.dev/crawler)


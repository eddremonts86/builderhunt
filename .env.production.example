# builderhunt — Production Environment Configuration
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production — only .env.production.example is tracked.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://builderhunt.eduardoinerarte.dk
VITE_APP_URL=https://builderhunt.eduardoinerarte.dk

# ── Database ──────────────────────────────────────────────────────────────────
# The web service receives only DATABASE_URL. Supply DATABASE_MIGRATION_URL to
# the migration job and DATABASE_WORKER_URL only to the worker service.
DATABASE_URL=postgresql://builderhunt_app:change_me_runtime_password@db:5432/builderhunt
DATABASE_MIGRATION_URL=postgresql://migration_operator:change_me_owner_password@db:5432/builderhunt
DATABASE_AUTH_URL=postgresql://builderhunt_auth:change_me_auth_password@db:5432/builderhunt
DATABASE_WORKER_URL=postgresql://builderhunt_worker:change_me_worker_password@db:5432/builderhunt
DATABASE_PLATFORM_URL=postgresql://builderhunt_platform:change_me_platform_password@db:5432/builderhunt
# This is the deployment that owns the real customer database, so it is the ONLY one that sets `production`.
#
# `env.ts` refuses to boot on a mode mismatch between this and `STRIPE_SECRET_KEY`: `sk_live_` requires
# `production` here, and `sk_test_` is refused when it is set. **A production deployment that switches to
# `sk_live_` without this line will fail to start** — deliberately, since the alternative is charging real
# cards against rows the production ledger does not contain. See
# plans/phase-1/30-stripe-billing-platform/staging-test-plan.md §7.
#
# Harmless today: production runs `STRIPE_BILLING_ENABLED=false` with no key, and the check only ever
# compares a key's mode against this value.
DB_ENV_MARKER=production

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_MODE=local
BETTER_AUTH_SECRET=change_me_generate_with_openssl  # openssl rand -base64 32
BETTER_AUTH_URL=https://builderhunt.eduardoinerarte.dk

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                        # from resend.com

# ── External Source API Tokens ────────────────────────────────────────────────
GITHUB_TOKEN=                          # github.com → Settings → Developer settings → PAT
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
# No third-party error tracking for v1 — structured stdout logs (src/shared/lib/log.ts),
# /api/admin/metrics and the /status page are the launch answer. Deliberate decision, see
# plans/phase-1/02-production-infrastructure/spec.md. Do not reintroduce a phantom DSN var:
# an env var for a service nothing reads invites someone to wire it without the decision.

# ── AI (Plan: ai-expansion / semantic-search) ─────────────────────────────────
# See plans/_meta/ai-policy.md and docs/operations/database-migrations.md
# ("Self-hosted embeddings" section) for the full deployment contract.
MINIMAX_API_KEY=                       # unset = server AI tier disabled (Chrome AI still works)
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=MiniMax-M3
# Embeddings: self-hosted Ollama container (docker-compose.yml `embeddings`
# service), deployed as its own Coolify resource, serving nomic-embed-text
# (768-dim) via its OpenAI-compatible /v1/embeddings endpoint. Point this at
# that resource's internal hostname — never MiniMax (ai-policy.md §3).
AI_EMBEDDING_URL=http://embeddings:11434/v1/embeddings
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIM=768
AI_EMBEDDING_TIMEOUT_MS=30000
AI_DISABLED=false                      # kill switch — set true + redeploy to disable all server AI
AI_DISABLED_TASKS=

# ── Public Profile Enrichment (plan: stealth-scraping) ───────────────────────
# Stays false until the source register + legal copy + canary in
# implementation_plan.md Phase 7 are all signed off. This is the production
# kill switch: false means no jobs are ever created and the worker is a no-op.
ENRICHMENT_ENABLED=false
ENRICHMENT_ALLOWED_CONNECTORS=github
ENRICHMENT_BATCH_SIZE=2                # per implementation_plan.md rollout: batch size 2 for the canary
ENRICHMENT_MAX_ATTEMPTS=3
ENRICHMENT_LEASE_SECONDS=300
ENRICHMENT_RAW_RETENTION_DAYS=30
ENRICHMENT_ACCEPTED_RETENTION_DAYS=180
ENRICHMENT_USER_AGENT=BuilderHuntBot/1.0 (+https://builderhunt.dev/crawler)

# ── Calendar / Scheduling / Interview Intelligence (plan: calendar-scheduling-interview-intelligence) ─
# 8 independently-togglable release flags, all off by default. Turning one off blocks new actions
# but preserves authorized read/export/delete access; it never removes saved data.
CALENDAR_ENABLED=false
SCHEDULING_ENABLED=false
CANDIDATE_UPLOADS_ENABLED=false
CANDIDATE_WEB_IMPORT_ENABLED=false
SENSITIVE_AI_ENABLED=false
INTERVIEW_TRANSCRIPTION_ENABLED=false
INTERVIEW_CONTEXTUAL_QUESTIONS_ENABLED=false
CALENDAR_OPERATIONAL_LAYERS_ENABLED=false
# Cloudflare R2 — private Standard bucket, EU jurisdiction. Required when
# CANDIDATE_UPLOADS_ENABLED=true. Endpoint must resolve to *.eu.r2.cloudflarestorage.com.
INTERVIEW_R2_ENDPOINT=
INTERVIEW_R2_ACCOUNT_ID=
INTERVIEW_R2_BUCKET=
INTERVIEW_R2_ACCESS_KEY_ID=
INTERVIEW_R2_SECRET_ACCESS_KEY=
INTERVIEW_R2_JURISDICTION=eu
# ClamAV — required when CANDIDATE_UPLOADS_ENABLED=true.
INTERVIEW_CLAMAV_HOST=
INTERVIEW_CLAMAV_PORT=3310
# Deepgram EU endpoint — required when INTERVIEW_TRANSCRIPTION_ENABLED=true.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com
# Sensitive text AI — required when SENSITIVE_AI_ENABLED=true. Never silently falls back to
# MiniMax. See docs/operations/interview-provider-register.md §4.
SENSITIVE_AI_PROVIDER=mistral          # mistral | azure
# Mistral La Plateforme (primary, EU-native). env.ts pins the base URL exactly and rejects
# *-latest model aliases.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-medium-2604
# ⚠️ Not enforceable from env: at admin.mistral.ai → API → Privacidad, the training opt-in must be
# OFF and "Labs models" must be OFF (Labs overrides the opt-out). Re-verify after any plan change.
# Azure OpenAI regional EU deployment — retained fallback, required when provider=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Retention ceilings (spec.md "Consent, privacy, and retention" → Defaults).
INTERVIEW_TRANSCRIPT_RETENTION_DAYS=90
INTERVIEW_DOCUMENT_RETENTION_DAYS=180
INTERVIEW_CONSENT_RETENTION_MONTHS=24


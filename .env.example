# builderhunt — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# See tasks/env-unification-plan.md for the full naming convention reference.
# NEVER commit .env — only .env.example is tracked.
#
# NOTE: builderhunt uses Better Auth without Clerk. AUTH_MODE is always "local".
 

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000          # Public base URL (auth redirects, webhooks)
VITE_APP_URL=http://localhost:3000     # client-side mirror of APP_URL

# ── Database ──────────────────────────────────────────────────────────────────
# For local dev: uses default port 5432
DATABASE_URL=postgresql://builderhunt_app:local_app_password@localhost:5432/builderhunt
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/builderhunt
DATABASE_WORKER_URL=postgresql://builderhunt_worker:local_worker_password@localhost:5432/builderhunt
# Runtime, migration, and worker credentials must be distinct in production.

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_MODE=local                        # builderhunt uses local auth only (no Clerk)
BETTER_AUTH_SECRET=                    # openssl rand -hex 32 (min 64 chars)

# ── Observability ─────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=                       # from sentry.io → Project → DSN (empty = disabled)

# ── Email (optional) ──────────────────────────────────────────────────────────
RESEND_API_KEY=                        # from resend.com — used for alert emails

# ── External Source API Tokens (optional) ─────────────────────────────────────
# All sources work without tokens but rate limits are stricter without them
GITHUB_TOKEN=                          # from github.com → Settings → Developer settings → PAT
REDDIT_CLIENT_ID=                      # from reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=

# ── Default local admin (seeded by db:seed:admin) ────────────────────────────
# Run `pnpm db:seed:admin` after migrations to create the initial admin user.
# These same values live in the workspace-level .env so they stay consistent.
DEFAULT_ADMIN_EMAIL=edd_admin@local.com
DEFAULT_ADMIN_PASSWORD=Passw0rd!234

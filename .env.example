# builderhunt — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# See tasks/env-unification-plan.md for the full naming convention reference.
# NEVER commit .env — only .env.example is tracked.
#
# NOTE: builderhunt uses Better Auth without Clerk. AUTH_MODE is always "local".
 

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000          # Public base URL (auth redirects, webhooks)
VITE_APP_URL=http://localhost:3000     # client-side mirror of APP_URL

# ── Database ──────────────────────────────────────────────────────────────────
# For local dev: uses default port 5432
DATABASE_URL=postgresql://builderhunt_app:local_app_password@localhost:5432/builderhunt
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/builderhunt
DATABASE_AUTH_URL=postgresql://builderhunt_auth:local_auth_password@localhost:5432/builderhunt
DATABASE_WORKER_URL=postgresql://builderhunt_worker:local_worker_password@localhost:5432/builderhunt
DATABASE_PLATFORM_URL=postgresql://builderhunt_platform:local_platform_password@localhost:5432/builderhunt
# The public capability identity (drizzle/0078) — the accountless candidate booking flow. Its grants
# are narrower than the worker's in one direction (no DELETE anywhere, no access to organizations,
# auth_users, or billing) and wider in another (it may create the interview event and write a
# candidate's own submission and consent, which no background job may do).
#
# Optional. Left unset, the app falls back to the worker URL and the public scheduling flow fails
# closed with a permission error — the worker has no INSERT on those tables. That is deliberate: it
# never silently runs with wider privileges than it should have.
DATABASE_CAPABILITY_URL=postgresql://builderhunt_capability:local_capability_password@localhost:5432/builderhunt
# Runtime, auth, migration, worker, platform, and capability credentials must all be distinct in
# production; env.ts rejects any two that match.

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_MODE=local                        # builderhunt uses local auth only (no Clerk)
BETTER_AUTH_SECRET=                    # openssl rand -hex 32 (min 64 chars)

# ── Observability ─────────────────────────────────────────────────────────────
# Error tracking: structured logs only for v1 (src/shared/lib/log.ts) — no Sentry
# or other third-party error-tracking provider is wired up or referenced in src/.

# ── AI (Plan: ai-expansion / semantic-search) ─────────────────────────────────
# MiniMax M3 (server-side chat completions) — leave MINIMAX_API_KEY empty to
# disable Tier 2 AI (Chrome on-device AI keeps working; server tasks 503).
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=MiniMax-M3
# Embeddings are a separate, swappable, OpenAI-compatible vector endpoint —
# never MiniMax (see plans/_meta/ai-policy.md). Local dev: `docker compose
# --profile standalone up -d embeddings` runs Ollama serving nomic-embed-text
# (768-dim) at this URL; alternatively point at a local LM Studio instance.
AI_EMBEDDING_URL=http://localhost:11434/v1/embeddings
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIM=768
AI_EMBEDDING_TIMEOUT_MS=30000
AI_DISABLED=false                      # kill switch — true disables all server AI tasks
AI_DISABLED_TASKS=                     # comma-separated task ids to disable individually
CLAIMABLE_PROFILES_ENABLED=true        # kill switch for source-bound profile-claim verification
PORTFOLIOS_ENABLED=true                # kill switch for the verified-owner public portfolio pages
PROFILE_REMOVAL_ENABLED=false           # kill switch for the profile-removal/global-suppression subsystem
PROFILE_REMOVAL_HMAC_KEY=               # required when PROFILE_REMOVAL_ENABLED=true — 64 hex chars (32 bytes), generate with: openssl rand -hex 32 — must not reuse BETTER_AUTH_SECRET
PROFILE_REMOVAL_HMAC_KEY_PREVIOUS=      # set only while rotating PROFILE_REMOVAL_HMAC_KEY
CONVERSION_EVENTS_ENABLED=false        # kill switch for landing-funnel conversion analytics (off until consent copy is updated)
VITE_LANDING_CONVERSION_VARIANT=       # unset = baseline only; "treatment" pins every session to the treatment arm (tests/manual QA)

# ── Email (optional) ──────────────────────────────────────────────────────────
RESEND_API_KEY=                        # from resend.com — used for alert emails

# ── External Source API Tokens (optional) ─────────────────────────────────────
# All sources work without tokens but rate limits are stricter without them
GITHUB_TOKEN=                          # from github.com → Settings → Developer settings → PAT
REDDIT_CLIENT_ID=                      # from reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=
GITLAB_TOKEN=                          # from gitlab.com → Settings → Access Tokens, `read_api` scope
                                        # raises the search quota 2000/h → 6000/h and unlocks real
                                        # user/project directory search (unauthenticated search is
                                        # 401, so without this GitLab falls back to sampling the
                                        # top 500 starred public projects instead)
CODEBERG_API_URL=                      # defaults to https://codeberg.org/api/v1 if unset; point at
                                        # any other Gitea/Forgejo instance instead
CODEBERG_TOKEN=                        # optional, raises the rate limit; from codeberg.org →
                                        # Settings → Applications
HUGGINGFACE_TOKEN=                     # optional, raises rate limits; from huggingface.co →
                                        # Settings → Access Tokens, read scope
STACKOVERFLOW_API_KEY=                 # register an app at stackapps.com/apps/register; raises
                                        # quota 300/day/IP → 10k/day
PRODUCTHUNT_TOKEN=                     # REQUIRED for the Product Hunt source to return anything
                                        # at all (the v2 GraphQL API mandates auth) — create a
                                        # Developer Token at api.producthunt.com/v2/docs

# ── Default local admin (seeded by db:seed:admin) ────────────────────────────
# Run `pnpm db:seed:admin` after migrations to create the initial admin user.
# These same values live in the workspace-level .env so they stay consistent.
DEFAULT_ADMIN_EMAIL=edd_admin@local.com
DEFAULT_ADMIN_PASSWORD=Passw0rd!234

# ── saas-review test users (seeded by db:seed:test-users) ────────────────────
# One workspace owner, one admin, one member — all inside the owner's personal
# workspace. The `/saas-review` skill (see ai-os/ai-config/skills/saas-review)
# reads these to drive role-based UI coverage of the app.
#
# Test/dev only — emails end in `.local`, passwords are deterministic. The seed
# script refuses to run against a non-localhost database.
SAAS_REVIEW_OWNER_EMAIL=saas-review-owner@test.local
SAAS_REVIEW_OWNER_PASSWORD="SaasReview!Owner#1"
SAAS_REVIEW_ADMIN_EMAIL=saas-review-admin@test.local
SAAS_REVIEW_ADMIN_PASSWORD="SaasReview!Admin#1"
SAAS_REVIEW_MEMBER_EMAIL=saas-review-member@test.local
SAAS_REVIEW_MEMBER_PASSWORD="SaasReview!Member#1"
# Alternative: a single JSON blob. The skill prefers this when set, else falls
# back to the per-role vars above.
# SAAS_REVIEW_USERS_JSON={"owner":{"email":"…","password":"…"},"admin":{…},"member":{…}}

# ── Public Profile Enrichment (plan: stealth-scraping) ───────────────────────
# Disabled by default. See docs/operations/public-enrichment-source-register.md
# before ever setting ENRICHMENT_ENABLED=true anywhere, including locally.
ENRICHMENT_ENABLED=false
ENRICHMENT_ALLOWED_CONNECTORS=github
ENRICHMENT_BATCH_SIZE=10
ENRICHMENT_MAX_ATTEMPTS=3
ENRICHMENT_LEASE_SECONDS=300
ENRICHMENT_RAW_RETENTION_DAYS=30
ENRICHMENT_ACCEPTED_RETENTION_DAYS=180
ENRICHMENT_USER_AGENT=BuilderHuntBot/1.0 (+https://builderhunt.dev/crawler)

# ── Devpost Ingestion (plan: devpost-integration) ────────────────────────────
# Disabled by default. Devpost has no API and bot-challenges plain fetch, so
# this is a headless-browser (Playwright/Chromium) cron worker, not a live
# connector — see plans/phase-1/19-devpost-integration/spec.md and
# docs/operations/deploy-runbook.md before setting this true anywhere,
# including locally (product-owner decision recorded 2026-07-25: scraping
# approved).
DEVPOST_ENABLED=false
DEVPOST_PROJECTS_PER_RUN=8
DEVPOST_PROFILES_PER_RUN=20
DEVPOST_REQUEST_DELAY_MS=1500

# ── Stripe Billing (plan: stripe-billing-platform) ───────────────────────────
# Disabled by default. See docs/operations/stripe-launch-register.md before
# ever setting STRIPE_BILLING_ENABLED=true anywhere, including locally — every
# release gate there must have evidence first. Never commit a real key here;
# this file only documents variable names.
STRIPE_BILLING_ENABLED=false
# Which database this process is pointed at. Only the deployment owning the real customer database sets
# `production`; leave it unset or `development` locally. env.ts refuses a `sk_live_` key unless this says
# `production`, and refuses a `sk_test_` key when it does — see staging-test-plan.md §7. Unset counts as
# "not production", so forgetting it can only ever refuse a live key, never permit one.
DB_ENV_MARKER=development              # production | staging | development | test
STRIPE_SECRET_KEY=                     # sk_test_... from dashboard.stripe.com → Developers → API keys (test mode)
STRIPE_WEBHOOK_SECRET=                 # whsec_... from `stripe listen` (local) or a Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET_PREVIOUS=        # set only during a webhook secret rotation window; unset once rotation completes
STRIPE_API_VERSION=                    # pin the exact version the SDK/webhook endpoint/fixtures all share
WEBHOOK_PAYLOAD_ENCRYPTION_KEY=        # 64 hex chars (32 bytes) — generate with: openssl rand -hex 32
# A second sk_test_ key, read ONLY by the opt-in real-Stripe certification suites
# (canary-certification.test.ts, test-clock-lifecycle.test.ts — see docs/operations/stripe-live-rollout.md).
# Deliberately separate from STRIPE_SECRET_KEY above: those suites create and destroy real sandbox
# customers, subscriptions and test clocks, and should not share an idempotency namespace with the
# running app. Leave it empty and the suites skip themselves; they never run without
# RUN_STRIPE_INTEGRATION_TESTS=1 either.
STRIPE_SANDBOX_SECRET_KEY=             # sk_test_... optional; certification suites only, never sk_live_

# ── Abuse and Usage Integrity (plan: abuse-and-usage-integrity) ──────────────
# All optional, fail-open to the safe default — an unset value never changes
# existing behavior. ABUSE_ENFORCEMENT_MODE stays `observe` (signals only,
# nothing blocked/throttled) until an operator deliberately moves it further.
ABUSE_ENFORCEMENT_MODE=observe         # observe | warn | enforce
SESSION_MAX_CONCURRENT_FREE=2          # sized to allow one laptop + one phone
SESSION_MAX_CONCURRENT_PRO=3
SESSION_MAX_CONCURRENT_TEAM_PER_SEAT=2
SESSION_IDLE_TIMEOUT_MINUTES=10080     # 7 days
SESSION_ABSOLUTE_TIMEOUT_HOURS=720     # 30 days
SEAT_DAILY_SEARCHES=200
SEAT_DAILY_REVEALS=100
SEAT_DAILY_EXPORTS=20
SEAT_DAILY_MESSAGES=100
SIGNUP_REQUIRE_VERIFIED_EMAIL=false
SIGNUP_BLOCK_DISPOSABLE_EMAILS=false
ABUSE_ALLOWLIST_ASNS=                  # comma-separated ASNs (e.g. known corporate egress) to suppress IP-churn signals for

# ── Calendar / Scheduling / Interview Intelligence (plan: calendar-scheduling-interview-intelligence) ─
# 8 independently-togglable release flags. Turning one off blocks new actions but preserves
# authorized read/export/delete access; it never removes saved data.
#
# Calendar and scheduling are on here, unlike the rest: they are shipped and enabled in production, so
# a local server with them off cannot exercise what it is about to deploy. The remaining flags stay
# off because the features behind them are not built yet.
CALENDAR_ENABLED=true
SCHEDULING_ENABLED=true
CANDIDATE_UPLOADS_ENABLED=false
CANDIDATE_WEB_IMPORT_ENABLED=false
SENSITIVE_AI_ENABLED=false
INTERVIEW_TRANSCRIPTION_ENABLED=false
INTERVIEW_CONTEXTUAL_QUESTIONS_ENABLED=false
CALENDAR_OPERATIONAL_LAYERS_ENABLED=false
# Cloudflare R2 — private Standard bucket, EU jurisdiction. Required in production when
# CANDIDATE_UPLOADS_ENABLED=true. Endpoint must resolve to *.eu.r2.cloudflarestorage.com.
INTERVIEW_R2_ENDPOINT=
INTERVIEW_R2_ACCOUNT_ID=
INTERVIEW_R2_BUCKET=
INTERVIEW_R2_ACCESS_KEY_ID=
INTERVIEW_R2_SECRET_ACCESS_KEY=
INTERVIEW_R2_JURISDICTION=eu
# ClamAV — every uploaded object is streamed through this before it moves to the clean prefix.
# Required in production when CANDIDATE_UPLOADS_ENABLED=true.
INTERVIEW_CLAMAV_HOST=
INTERVIEW_CLAMAV_PORT=3310
# Deepgram EU endpoint — required in production when INTERVIEW_TRANSCRIPTION_ENABLED=true.
# Default base URL is already the EU endpoint so an operator can't accidentally point at the
# global one just by omitting the var.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com
# Sensitive text AI. Never silently falls back to MiniMax (spec.md). Provider is selectable —
# see docs/operations/interview-provider-register.md §4 for why Mistral became primary.
SENSITIVE_AI_PROVIDER=mistral          # mistral | azure
# Mistral La Plateforme (primary). EU processing is the platform default; the US endpoint is an
# opt-in, so env.ts pins the base URL to exactly https://api.mistral.ai and fails closed on
# anything else. Required when SENSITIVE_AI_ENABLED=true and provider=mistral.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
# Pin a dated model id. env.ts REJECTS *-latest aliases: this model writes candidate-evaluation
# text, so an unannounced version change is a fairness/audit problem, not just a quality one.
MISTRAL_MODEL=mistral-medium-2604
# ⚠️ Two org-level settings at admin.mistral.ai → API → Privacidad are NOT covered by env vars and
# must be checked by hand: the API training opt-in (arrives ON, and does not persist from the
# signup form), and "Labs models" (overrides the training opt-out entirely). Both must be OFF.
# Azure OpenAI regional EU deployment — retained fallback, required when provider=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Retention ceilings (spec.md "Consent, privacy, and retention" → Defaults). Organizations may
# select shorter periods; these are the operator-wide ceiling the retention worker enforces.
INTERVIEW_TRANSCRIPT_RETENTION_DAYS=90
INTERVIEW_DOCUMENT_RETENTION_DAYS=180
INTERVIEW_CONSENT_RETENTION_MONTHS=24


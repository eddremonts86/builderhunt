# BuilderHunt — Environment Variables

# Database (PostgreSQL)
# For local dev with Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/builderhunt
# For Coolify deployment: DATABASE_URL is auto-injected or baked into Dockerfile

# Auth (better-auth) — REQUIRED
AUTH_SECRET=your-64-char-random-secret-here
# Generate with: openssl rand -hex 32

# Email (Resend — optional, for alerts)
RESEND_API_KEY=

# App URL
APP_URL=https://your-domain.com
VITE_APP_URL=https://your-domain.com

# Source API tokens (optional — all sources work without tokens but have stricter rate limits)
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
